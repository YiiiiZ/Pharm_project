ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.5
DJANGO_SECRET_KEY=change-this-to-a-random-string

# pgvector store for rag/embed.py and rag/retrieve.py.
# Use this value (localhost:5433) when running the scripts from the local
# venv against `docker compose up -d vector_db`. Use
# postgresql://postgres:postgres@vector_db:5432/spl_vectors instead if you
# ever run these scripts from inside the web container.
VECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/spl_vectors

DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
